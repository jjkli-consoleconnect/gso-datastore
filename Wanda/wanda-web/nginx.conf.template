server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Keep browser calls same-origin while forwarding only the UAT Wanda API.
    location /api/wanda/ {
        proxy_pass https://wanda-adk-service-bot-ene4rzqhla-nw.a.run.app/;
        proxy_ssl_server_name on;
        proxy_set_header Host wanda-adk-service-bot-ene4rzqhla-nw.a.run.app;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
