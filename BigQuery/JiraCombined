SELECT
  t.T,
  t.Project,
  t.Key,
  t.Summary,
  t.Status,
  t.Created,
  t.Updated,
  t.Resolved,
  t.Reporter,
  t.Assignee,
  t.Component,
  t.RemedyTicketNumber,
  t.Links,
  t.SR_Ref,
  t.SyncTime,
  c.Comment_ID,
  c.Author_Account_ID,
  c.Author_Display_Name,
  c.Created AS Comment_Created,
  c.Updated AS Comment_Updated,
  c.Body,
  c.Visibility_Type,
  c.Visibility_Value,
  c.SyncTime AS Comment_SyncTime,
  c.InsertedAt AS Comment_InsertedAt,
  ch.History_ID,
  ch.Transition_Timestamp,
  ch.Transitioned_From,
  ch.Transitioned_To,
  ch.Transitioned_By_Account_ID,
  ch.Transitioned_By_Display_Name,
  ch.SyncTime AS Changelog_SyncTime
FROM
  `pccw-internal-virt-agent-uat.GSO.JiraTickets` t
LEFT JOIN
  `pccw-internal-virt-agent-uat.GSO.JiraComments` c
ON
  t.Key = c.Issue_Key
LEFT JOIN
  `pccw-internal-virt-agent-uat.GSO.JiraChangelog` ch
ON
  t.Key = ch.Issue_Key