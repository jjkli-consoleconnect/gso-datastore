import requests
import json
import logging
import os
import time
import uuid
from datetime import datetime, timezone
from typing import Optional
from concurrent.futures import ThreadPoolExecutor, as_completed

from google.cloud import bigquery
from google.oauth2 import service_account

from pipeline_runs_logger import log_pipeline_run

# Configure logging
DEBUG = str(os.environ.get('DEBUG', '')).lower() in ('1', 'true', 'yes')
_env_level = os.environ.get('LOG_LEVEL', 'DEBUG' if DEBUG else 'INFO').upper()
_level = getattr(logging, _env_level, logging.INFO)
logging.basicConfig(level=_level, format='%(asctime)s - %(levelname)s - %(message)s')

LOG_BUFFER = []


def load_config():
    try:
        with open('config.json') as f:
            return json.load(f)
    except FileNotFoundError:
        logging.error('config.json not found')
        return None


def load_base_jql(default_text: Optional[str] = None) -> Optional[str]:
    env = os.environ.get('BASE_JQL')
    if env:
        return env
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(script_dir, 'JQL.txt')
    if os.path.isfile(candidate):
        with open(candidate, 'r', encoding='utf-8') as f:
            return f.read().strip()
    return default_text


def convert_timestamp(ts: Optional[str]) -> Optional[str]:
    if not ts:
        return None
    try:
        if ts.endswith('Z'):
            return datetime.strptime(ts, '%Y-%m-%dT%H:%M:%S.%fZ').strftime('%Y-%m-%d %H:%M:%S')
        return datetime.strptime(ts, '%Y-%m-%dT%H:%M:%S.%f%z').strftime('%Y-%m-%d %H:%M:%S')
    except Exception:
        try:
            return datetime.strptime(ts, '%Y-%m-%dT%H:%M:%SZ').strftime('%Y-%m-%d %H:%M:%S')
        except Exception:
            return None


def create_or_replace_temp_table(client: bigquery.Client, dataset_id: str, table_id: str, schema):
    cols = ', '.join(f'`{f.name}` {f.field_type}' for f in schema)
    q = f'CREATE OR REPLACE TABLE `{client.project}.{dataset_id}.{table_id}` ({cols})'
    try:
        client.query(q).result()
        logging.info('Temp table created')
        return True
    except Exception as e:
        logging.exception('Failed to create temp table: %s', e)
        return False


def delete_temp_table(client: bigquery.Client, dataset_id: str, table_id: str):
    try:
        client.delete_table(f'{client.project}.{dataset_id}.{table_id}', not_found_ok=True)
    except Exception:
        try:
            client.delete_table(f'{client.project}.{dataset_id}.{table_id}')
        except Exception:
            pass


def insert_rows_with_retry(client: bigquery.Client, dataset_id: str, table_id: str, rows: list, retries=5, delay=5):
    if not rows:
        return True
    table_ref = f'{client.project}.{dataset_id}.{table_id}'
    for _ in range(retries):
        try:
            errors = client.insert_rows_json(table_ref, rows)
            if not errors:
                return True
            logging.error('Insert returned errors: %s', errors)
        except Exception as e:
            logging.exception('Insert failed: %s', e)
        time.sleep(delay)
    return False


def fetch_comments_for_issue(jira_base: str, issue_key: str, username: str, api_token: str):
    url = f'{jira_base}/rest/api/2/issue/{issue_key}/comment'
    auth = (username, api_token)
    comments = []
    start_at = 0
    max_results = 100
    while True:
        params = {'startAt': start_at, 'maxResults': max_results}
        try:
            r = requests.get(url, auth=auth, params=params, timeout=120)
            r.raise_for_status()
            data = r.json()
            chunk = data.get('comments', [])
            comments.extend(chunk)
            total = data.get('total', 0)
            if start_at + len(chunk) >= total:
                break
            start_at += len(chunk)
        except Exception as e:
            logging.error('Failed fetch comments for %s: %s', issue_key, e)
            return None
    return comments


def fetch_comments_batch(jira_base: str, issue_keys: list, username: str, api_token: str):
    def worker(k):
        return k, fetch_comments_for_issue(jira_base, k, username, api_token)

    results = {}
    with ThreadPoolExecutor(max_workers=8) as ex:
        futures = {ex.submit(worker, k): k for k in issue_keys}
        for fut in as_completed(futures):
            k = futures[fut]
            try:
                key, comments = fut.result()
                results[key] = comments
            except Exception as e:
                logging.error('Worker failed for %s: %s', k, e)
                results[k] = None
    return results


def generate_rows(issues: list, jira_base: str, username: str, api_token: str):
    keys = [i.get('key') for i in issues if i.get('key')]
    if not keys:
        return
    cmap = fetch_comments_batch(jira_base, keys, username, api_token)
    now = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')
    for k in keys:
        comments = cmap.get(k)
        if not comments:
            continue
        for c in comments:
            yield {
                'Issue_Key': k,
                'Comment_ID': str(c.get('id')),
                'Author_Account_ID': c.get('author', {}).get('accountId'),
                'Author_Display_Name': c.get('author', {}).get('displayName'),
                'Created': convert_timestamp(c.get('created')),
                'Updated': convert_timestamp(c.get('updated')),
                'Body': c.get('body'),
                'Visibility_Type': c.get('visibility', {}).get('type'),
                'Visibility_Value': c.get('visibility', {}).get('value'),
                'SyncTime': now,
                'InsertedAt': now,
            }


def wait_for_table(client: bigquery.Client, dataset_id: str, table_id: str, retries=10, delay=3):
    for _ in range(retries):
        try:
            client.get_table(f'{client.project}.{dataset_id}.{table_id}')
            return True
        except Exception:
            time.sleep(delay)
    return False


def sync_comments_to_bigquery(jira_base: str, jql: str, username: str, api_token: str, dataset_id: str, table_id: str, client: bigquery.Client):
    temp = 'JiraComments_temp'
    schema = [
        bigquery.SchemaField('Issue_Key', 'STRING'),
        bigquery.SchemaField('Comment_ID', 'STRING'),
        bigquery.SchemaField('Author_Account_ID', 'STRING'),
        bigquery.SchemaField('Author_Display_Name', 'STRING'),
        bigquery.SchemaField('Created', 'TIMESTAMP'),
        bigquery.SchemaField('Updated', 'TIMESTAMP'),
        bigquery.SchemaField('Body', 'STRING'),
        bigquery.SchemaField('Visibility_Type', 'STRING'),
        bigquery.SchemaField('Visibility_Value', 'STRING'),
        bigquery.SchemaField('SyncTime', 'TIMESTAMP'),
        bigquery.SchemaField('InsertedAt', 'TIMESTAMP'),
    ]

    if not create_or_replace_temp_table(client, dataset_id, temp, schema):
        logging.error('Temp table create failed')
        return -1
    if not wait_for_table(client, dataset_id, temp):
        logging.error('Temp table not available')
        return -1

    search_url = f'{jira_base}/rest/api/2/search'
    headers = {'Accept': 'application/json', 'Content-Type': 'application/json'}
    auth = (username, api_token)
    start_at = 0
    max_results = 100
    total = float('inf')
    batch = []
    batch_size = 500
    total_inserted = 0

    while start_at < total:
        payload = json.dumps({'jql': jql, 'startAt': start_at, 'maxResults': max_results, 'fields': ['key']})
        try:
            resp = requests.post(search_url, headers=headers, auth=auth, data=payload, timeout=300)
            resp.raise_for_status()
            data = resp.json()
        except Exception as e:
            logging.exception('Jira search failed: %s', e)
            delete_temp_table(client, dataset_id, temp)
            return -1

        issues = data.get('issues', [])
        total = data.get('total', 0)
        if not issues:
            break

        for row in generate_rows(issues, jira_base, username, api_token):
            batch.append(row)
            if len(batch) >= batch_size:
                if not insert_rows_with_retry(client, dataset_id, temp, batch):
                    logging.error('Failed to insert batch')
                    delete_temp_table(client, dataset_id, temp)
                    return -1
                total_inserted += len(batch)
                batch = []

        start_at += len(issues)
        time.sleep(1)

    if batch:
        if not insert_rows_with_retry(client, dataset_id, temp, batch):
            logging.error('Failed final insert')
            delete_temp_table(client, dataset_id, temp)
            return -1
        total_inserted += len(batch)

    merge_q = f'''
        MERGE `{client.project}.{dataset_id}.{table_id}` T
        USING (SELECT * FROM `{client.project}.{dataset_id}.{temp}`) S
        ON T.Comment_ID = S.Comment_ID AND T.Updated = S.Updated
        WHEN MATCHED THEN
            UPDATE SET
                Issue_Key = S.Issue_Key,
                Author_Account_ID = S.Author_Account_ID,
                Author_Display_Name = S.Author_DISPLAY_NAME,
                Created = S.Created,
                Updated = S.Updated,
                Body = S.Body,
                Visibility_Type = S.Visibility_Type,
                Visibility_Value = S.Visibility_Value,
                SyncTime = S.SyncTime,
                InsertedAt = S.InsertedAt
        WHEN NOT MATCHED THEN
            INSERT (Issue_Key, Comment_ID, Author_Account_ID, Author_DISPLAY_NAME, Created, Updated, Body, Visibility_Type, Visibility_Value, SyncTime, InsertedAt)
            VALUES (S.Issue_Key, S.Comment_ID, S.Author_Account_ID, S.Author_DISPLAY_NAME, S.Created, S.Updated, S.Body, S.Visibility_Type, S.Visibility_Value, S.SyncTime, S.InsertedAt)
    '''
    try:
        client.query(merge_q).result()
    except Exception as e:
        logging.exception('Merge failed: %s', e)
        delete_temp_table(client, dataset_id, temp)
        return -1

    delete_temp_table(client, dataset_id, temp)
    return int(total_inserted)


def log_to_bigquery(client: bigquery.Client, dataset_id: str, table_id: str, pipeline_name: str, run_id: str, level: str, message: str, function_name=None, batch_id=None, details=None):
    LOG_BUFFER.append({
        'Timestamp': datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S'),
        'PipelineName': pipeline_name,
        'RunID': run_id,
        'LogLevel': level,
        'Message': message,
        'FunctionName': function_name,
        'BatchID': batch_id,
        'Details': details,
    })


def flush_logs_to_bigquery(client: bigquery.Client, dataset_id: str, table_id: str):
    if not LOG_BUFFER:
        return
    temp = f'PipelineLogs_temp_{str(uuid.uuid4()).replace("-", "")}'
    schema = [
        bigquery.SchemaField('Timestamp', 'TIMESTAMP'),
        bigquery.SchemaField('PipelineName', 'STRING'),
        bigquery.SchemaField('RunID', 'STRING'),
        bigquery.SchemaField('LogLevel', 'STRING'),
        bigquery.SchemaField('Message', 'STRING'),
        bigquery.SchemaField('FunctionName', 'STRING'),
        bigquery.SchemaField('BatchID', 'STRING'),
        bigquery.SchemaField('Details', 'STRING'),
    ]
    if not create_or_replace_temp_table(client, dataset_id, temp, schema):
        logging.error('Failed to create temp log table')
        return
    if not insert_rows_with_retry(client, dataset_id, temp, LOG_BUFFER):
        logging.error('Failed to insert logs into temp')
        return
    merge_q = f'''
        MERGE `{client.project}.{dataset_id}.{table_id}` T
        USING (SELECT * FROM `{client.project}.{dataset_id}.{temp}`) S
        ON T.RunID = S.RunID AND T.Message = S.Message
        WHEN NOT MATCHED THEN
            INSERT (Timestamp, PipelineName, RunID, LogLevel, Message, FunctionName, BatchID, Details)
            VALUES (S.Timestamp, S.PipelineName, S.RunID, S.LogLevel, S.Message, S.FunctionName, S.BATCHID, S.Details)
    '''
    try:
        client.query(merge_q).result()
    except Exception:
        logging.exception('Failed to merge logs')
    try:
        client.delete_table(f'{client.project}.{dataset_id}.{temp}', not_found_ok=True)
    except Exception:
        pass


def main():
    config = load_config()
    if config is None:
        return
    jira_base = os.environ.get('JIRA_BASE_URL', 'https://consoleconnect.atlassian.net')
    username = config.get('jira_user')
    api_token = config.get('jira_api_token')
    if not api_token:
        logging.error('Missing jira_api_token in config.json')
        return

    dataset = 'GSO'
    table = 'JiraComments'
    logs = 'PipelineLogs'
    pipeline = 'jira_comments'
    run_id = str(uuid.uuid4())

    base_default = '(project = TAC)'
    base_jql = load_base_jql(default_text=base_default)
    if not base_jql:
        logging.error('No base JQL found')
        return
    jql = f"{base_jql} AND updated >= -1h"

    client = None
    try:
        client = bigquery.Client()
    except Exception as e:
        logging.warning('ADC failed: %s - trying service account files', e)
        script_dir = os.path.dirname(os.path.abspath(__file__))
        repo_root = os.path.normpath(os.path.join(script_dir, '..', '..'))
        candidates = [os.path.join(repo_root, 'jira-bigquery-key.json'), os.path.join(repo_root, 'service-account.json')]
        for p in candidates:
            if os.path.isfile(p):
                try:
                    creds = service_account.Credentials.from_service_account_file(p)
                    client = bigquery.Client(credentials=creds, project=getattr(creds, 'project_id', None))
                    logging.info('Initialized BQ client with %s', p)
                    break
                except Exception:
                    logging.exception('Failed to init client from %s', p)

    if client is None:
        logging.error('Could not initialize BigQuery client; exiting')
        return

    log_to_bigquery(client, dataset, logs, pipeline, run_id, 'INFO', 'Pipeline started', function_name='main')
    try:
        log_pipeline_run(client, pipeline_name=pipeline, run_id=run_id, level='INFO', message='Pipeline started', status='RUNNING')
        rows = sync_comments_to_bigquery(jira_base, jql, username, api_token, dataset, table, client)
        if rows and rows >= 0:
            log_to_bigquery(client, dataset, logs, pipeline, run_id, 'INFO', f'Successfully processed {rows} rows', function_name='main')
            log_pipeline_run(client, pipeline_name=pipeline, run_id=run_id, level='INFO', message='Pipeline finished', status='SUCCESS', rows_merged=int(rows))
        else:
            log_to_bigquery(client, dataset, logs, pipeline, run_id, 'ERROR', 'Processing failed', function_name='main')
            log_pipeline_run(client, pipeline_name=pipeline, run_id=run_id, level='ERROR', message='Processing failed', status='ERROR')
    except Exception as e:
        logging.exception('Pipeline failed: %s', e)
        log_to_bigquery(client, dataset, logs, pipeline, run_id, 'ERROR', f'Pipeline failed: {e}', function_name='main')
        log_pipeline_run(client, pipeline_name=pipeline, run_id=run_id, level='ERROR', message=f'Pipeline failed: {e}', status='ERROR')

    flush_logs_to_bigquery(client, dataset, logs)


if __name__ == '__main__':
    main()
