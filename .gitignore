# Ignore only specific directories
/Backup/
/.tmp.driveupload/
*.clasp.json
*.gsheet
*.gscript
*.log
*.jsonl

# Ensure .gitignore itself is tracked
!.gitignore

# Configuration files with credentials (NEVER commit these)
pagerduty_config.json
jira_config.json
*_config.json

# Keys and credentials (explicit)
jira-bigquery-key.json
jira-bigquery-key-*.json
credentials.json
found-credentials.txt
service-account.json
service-account-*.json
handover-pubsub-key.json
looker_client_secret.json
client_secret.json
*_client_secret.json
*-key.json

# Ignore all credential files in any directory
**/credentials.json
**/service-account.json
**/jira-bigquery-key.json
**/handover-pubsub-key.json
**/looker_client_secret.json
**/client_secret.json
**/*_client_secret.json
**/*-key.json
**/*_config.json

# Archive folder for cleanup
Archive/

# Environment files
.env
.env.local
.env.*.local

# Local BigQuerySync overrides
BigQuerySync/bq-sync.config.local.json

# Local Jira config overrides
config.local.json
.config.json
**/config.local.json
**/.config.json