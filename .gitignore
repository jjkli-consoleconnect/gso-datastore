node_modules/
__pycache__/
*.py[cod]

# Ignore only specific directories
/Backup/
/.tmp.driveupload/
*.clasp.json
*.gsheet
*.gscript
*.log
*.jsonl

# Transient CloudFunctions diagnostics and command captures
/CloudFunctions/**/*_out.txt
/CloudFunctions/**/*_err.txt
/CloudFunctions/**/dep_*.txt
/CloudFunctions/**/id_token.txt
/CloudFunctions/**/tok_*.txt

# CloudFunctions contains deployable function folders only. Keep probes and
# one-off backfill helpers under Temp/<work-item>/.
/CloudFunctions/*.py
/CloudFunctions/*.cmd
/CloudFunctions/*.ps1
/CloudFunctions/*.txt
/CloudFunctions/*.json

# Ensure .gitignore itself is tracked
!.gitignore

# Configuration files with credentials (NEVER commit these)
pagerduty_config.json
jira_config.json
*_config.json

# Keys and credentials (explicit)
jira-bigquery-key.json
jira-bigquery-key-*.json
credentials.json
found-credentials.txt
service-account.json
service-account-*.json
handover-pubsub-key.json
looker_client_secret.json
client_secret.json
*_client_secret.json
*-key.json

# Ignore all credential files in any directory
**/credentials.json
**/service-account.json
**/jira-bigquery-key.json
**/handover-pubsub-key.json
**/looker_client_secret.json
**/client_secret.json
**/*_client_secret.json
**/*-key.json
**/*_config.json

# Archive folder for cleanup
Archive/

# Environment files
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# Local Cloud SDK credentials and token caches
.gcloud/
.gcloud-config/
application_default_credentials.json

# Python virtual environments
.venv/
.venv*/
venv/
venv*/
.cleanup_backup_venv-*/

# Local BigQuerySync overrides
BigQuerySync/bq-sync.config.local.json

# BigQuery pull fingerprint cache (delta mode; regenerated on every pull)
/BigQuerySync/.bq-sync.state.json

# Local Jira config overrides
config.local.json
.config.json
**/config.local.json
**/.config.json

# Large files and archives to improve performance
*.tgz
*.pack
*.idx
*.original
*.filtered
/Wanda/wanda-web/google-cloud-sdk/