{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "BigQuery: Pull",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/BigQuerySync/pull.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Pull (Delta)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/BigQuerySync/pull.ps1",
				"-Delta"
			],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Pull (DryRun)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/BigQuerySync/pull.ps1",
				"-DryRun"
			],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Pull (macOS)",
			"type": "shell",
			"command": "${workspaceFolder}/BigQuerySync/pull_macos.sh",
			"args": [],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Push (DryRun)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/BigQuerySync/push.ps1",
				"-DryRun"
			],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Push (Force)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/BigQuerySync/push.ps1",
				"-Force"
			],
			"problemMatcher": []
		},
		{
			"label": "Run jira_comments_initialsync container",
			"type": "shell",
			"command": "docker run --rm jira_comments_initialsync:latest",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Docker: Build jira_comments_initialsync",
			"type": "shell",
			"command": "docker build --pull --rm -f \"InitialSync\\jira_comments_initialsync\\Dockerfile\" -t \"jira_comments_initialsync:latest\" \".\"",
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Docker: Build jira_changelog_initialsync",
			"type": "shell",
			"command": "docker build --pull --rm -f \"InitialSync\\jira_changelog_initialsync\\Dockerfile\" -t \"jira_changelog_initialsync:latest\" \".\"",
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Docker: Run+Monitor jira_comments_initialsync",
			"type": "shell",
			"command": "powershell -NoProfile -Command \"$env:LOG_LEVEL=INFO; docker rm -f jira_comments_initialsync_run 2>$null; docker run -d --rm --name jira_comments_initialsync_run jira_comments_initialsync:latest | Out-Null; docker logs -f jira_comments_initialsync_run\"",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Docker: Build jira_tickets_initialsync",
			"type": "shell",
			"command": "docker build --pull --rm -f \"InitialSync\\jira_tickets_initialsync\\Dockerfile\" -t \"jira_tickets_initialsync:latest\" \".\"",
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Docker: Run+Monitor jira_tickets_initialsync",
			"type": "shell",
			"command": "powershell -NoProfile -Command \"$env:LOG_LEVEL=INFO; docker rm -f jira_tickets_initialsync_run 2>$null; docker run -d --rm --name jira_tickets_initialsync_run jira_tickets_initialsync:latest | Out-Null; docker logs -f jira_tickets_initialsync_run\"",
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Auth: ADC Login",
			"type": "shell",
			"command": "gcloud auth application-default login",
			"isBackground": false
		},
		{
			"label": "BigQuery: Load HubSpot Surveys (DryRun)",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/BigQuerySync/load_hubspot_surveys.py",
				"--dry-run"
			],
			"problemMatcher": []
		},
		{
			"label": "BigQuery: Load HubSpot Surveys",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/BigQuerySync/load_hubspot_surveys.py"
			],
			"problemMatcher": []
		}
	]
}