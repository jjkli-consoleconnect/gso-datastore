@echo off
rem 1) Summary with both statuses = Operation
call bq query --use_legacy_sql=false --format=csv "WITH ci AS (SELECT CONCAT('SR', CAST(SalesRecord AS STRING)) AS sr_key, SUM(MRC_USD) AS cost_items_mrc, COUNT(*) AS cost_lines FROM `edp-prod-lake-data-warehouse.Cost_Items.all_cost_items_report` WHERE SRStatus = 'Operation' GROUP BY sr_key), edp AS (SELECT CONCAT('SR', CAST(sr_id AS STRING)) AS sr_key, mrc_usd AS edp_mrc, customer_name FROM `edp-prod-lake-data-warehouse.DATA_676.dw_hub_sr` WHERE status_name = 'Operation') SELECT COUNT(DISTINCT e.sr_key) AS op_srs_edp, COUNT(DISTINCT c.sr_key) AS op_srs_costitems, COUNTIF(ABS(IFNULL(e.edp_mrc,0) - IFNULL(c.cost_items_mrc,0)) < 0.01) AS matching, COUNTIF(ABS(IFNULL(e.edp_mrc,0) - IFNULL(c.cost_items_mrc,0)) >= 0.01) AS mismatching, ROUND(SUM(e.edp_mrc),0) AS total_edp_mrc, ROUND(SUM(c.cost_items_mrc),0) AS total_ci_mrc FROM edp e FULL OUTER JOIN ci c USING (sr_key)"
rem 2) Sample SRs, both statuses = Operation, both MRCs present, mismatched
call bq query --use_legacy_sql=false --format=csv "WITH ci AS (SELECT CONCAT('SR', CAST(SalesRecord AS STRING)) AS sr_key, SUM(MRC_USD) AS cost_items_mrc, COUNT(*) AS cost_lines FROM `edp-prod-lake-data-warehouse.Cost_Items.all_cost_items_report` WHERE SRStatus = 'Operation' GROUP BY sr_key), edp AS (SELECT CONCAT('SR', CAST(sr_id AS STRING)) AS sr_key, mrc_usd AS edp_mrc, customer_name, status_name FROM `edp-prod-lake-data-warehouse.DATA_676.dw_hub_sr` WHERE status_name = 'Operation') SELECT e.sr_key, e.customer_name, e.edp_mrc, c.cost_items_mrc, c.cost_lines FROM edp e JOIN ci c USING (sr_key) WHERE ABS(IFNULL(e.edp_mrc,0) - IFNULL(c.cost_items_mrc,0)) >= 0.01 AND e.edp_mrc > 0 LIMIT 8"
