--transfer_config
--project_id=pccw-internal-virt-agent-uat
--target_dataset=GSO
--display_name=SHRPeople Monthly Snapshot Counts - Day1
--data_source=scheduled_query
--schedule=1 of month 00:05
--params={"use_legacy_sql":false,"query":"MERGE `pccw-internal-virt-agent-uat.GSO.SHRPeople_StatusMonthlyCounts` t\nUSING (\n  SELECT\n    DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY), MONTH) AS snapshot_month,\n    DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) AS snapshot_date,\n    COALESCE(NULLIF(TRIM(SR_Status), \u0027\u0027), \u0027Unknown\u0027) AS SR_Status,\n    COALESCE(NULLIF(TRIM(Circuit_Owner), \u0027\u0027), \u0027Unknown\u0027) AS Circuit_Owner,\n    COUNT(DISTINCT SRNo) AS sr_count,\n    CURRENT_TIMESTAMP() AS updated_at\n  FROM `pccw-internal-virt-agent-uat.GSO.SHRPeople`\n  GROUP BY 1,2,3,4\n) s\nON t.snapshot_month = s.snapshot_month\nAND t.SR_Status = s.SR_Status\nAND t.Circuit_Owner = s.Circuit_Owner\nWHEN MATCHED THEN UPDATE SET\n  t.snapshot_date = s.snapshot_date,\n  t.sr_count = s.sr_count,\n  t.updated_at = s.updated_at\nWHEN NOT MATCHED THEN INSERT (\n  snapshot_month,\n  snapshot_date,\n  SR_Status,\n  Circuit_Owner,\n  sr_count,\n  updated_at\n) VALUES (\n  s.snapshot_month,\n  s.snapshot_date,\n  s.SR_Status,\n  s.Circuit_Owner,\n  s.sr_count,\n  s.updated_at\n);"}
